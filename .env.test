# LibraryManagement/.env.test

# MongoDB Connection URI (ensure this is the correct one for your test setup)
# The MONGO_URI in docker-compose services will often take precedence if also defined there.
# However, your seed script might try to use this if MONGO_URI is not directly set in its own service's env vars.
MONGO_URI=mongodb://mongo-test:27017/library_management_test

# MongoDB Init Credentials (if mongo-init.js uses them)
# MONGO_INITDB_ROOT_USERNAME=testUser
# MONGO_INITDB_ROOT_PASSWORD=UKHUKH
# MONGO_INITDB_DATABASE=library_management_test # This is also set in docker-compose.test.yml

# Session Secret for Express session in test environment
SESSION_SECRET=UKH2025

# Standard Test User Credentials
# These will be used by seedDatabase.js and your tests.

TEST_LIBRARIAN_EMAIL="mainLibrarian@example.com"
TEST_LIBRARIAN_PASSWORD="Password123!"
TEST_LIBRARIAN_FULLNAME="Main Librarian"


TEST_MEMBER_EMAIL="testmember@example.com"
TEST_MEMBER_PASSWORD="MemberPass123!"
TEST_MEMBER_FULLNAME="Test Member"


CYPRESS_BASE_URL=http://frontend-e2e:3000
CYPRESS_API_URL=http://backend-e2e:8080

CYPRESS_TEST_LIBRARIAN_EMAIL=${TEST_LIBRARIAN_EMAIL}
CYPRESS_TEST_LIBRARIAN_PASSWORD=${TEST_LIBRARIAN_PASSWORD}
CYPRESS_TEST_MEMBER_EMAIL=${TEST_MEMBER_EMAIL}
CYPRESS_TEST_MEMBER_PASSWORD=${TEST_MEMBER_PASSWORD}
