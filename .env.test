# LibraryManagement/.env.test

# MongoDB URI for the test environment (no authentication)
MONGO_URI=mongodb://mongo-test:27017/library_management_test

# Session secret for the test environment
SESSION_SECRET=UKH2025

# MONGO_INITDB_ROOT_USERNAME and MONGO_INITDB_ROOT_PASSWORD are not strictly needed in this file
# for Option A, as the mongo-test service will start without auth if these are blank
# when substituted from this .env.test file in its own environment block.
# MONGO_INITDB_ROOT_USERNAME=
# MONGO_INITDB_ROOT_PASSWORD=