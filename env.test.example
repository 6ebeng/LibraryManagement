# Test Environment Variables
# Copy this file to .env.test before running tests

# MongoDB for Tests
MONGO_URI=mongodb://mongo-test:27017/library_management_test
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
MONGO_INITDB_DATABASE=library_management_test

# Server
PORT=8080
NODE_ENV=test
SESSION_SECRET=test_session_secret

# Test Users
TEST_LIBRARIAN_FULLNAME=Test Librarian
TEST_LIBRARIAN_EMAIL=testlibrarian@library.com
TEST_LIBRARIAN_PASSWORD=librarian123

TEST_MEMBER_FULLNAME=Test Member
TEST_MEMBER_EMAIL=testmember@library.com
TEST_MEMBER_PASSWORD=member123

# E2E Testing Flag
E2E_TESTING=false 