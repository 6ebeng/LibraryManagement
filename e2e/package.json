{
  "name": "cypress",
  "description": "Examples of end-to-end tests for Spryker Marketplace B2B demoshop",
  "version": "1.0.0",
  "private": true,
  "devDependencies": {
    "@cypress/react": "^9.0.1",
    "@cypress/react18": "^2.0.1",
    "@types/node": "^22.15.30",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "ajv": "^8.13.0",
    "cypress": "14.4.1",
    "cypress-iframe": "^1.0.1",
    "cypress-mochawesome-reporter": "^3.8.2",
    "cypress-plugin-api": "^2.11.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-cypress": "^3.2.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "3.2.5",
    "typescript": "~5.4.2"
  },
  "scripts": {
    "cy:open": "npx cypress open",
    "cy:run": "npx cypress run",
    "cy:run:docker": "npx cypress run --env docker=true",
    "lint:check": "eslint . ",
    "prettier:check": "prettier . --check",
    "code:check": "eslint . ; prettier . --check",
    "code:fix": "eslint . --fix ; prettier . --write",
    "seed:small": "node ../server/scripts/seedDatabase.js --volume=small",
    "seed:large": "node ../server/scripts/seedDatabase.js --volume=large"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "fs": "^0.0.1-security"
  },
  "ts-standard": {
    "project": "./tsconfig.json"
  }
}
