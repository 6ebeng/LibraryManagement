# Development Environment Variables
# Copy this file to .env.dev before running the application

# MongoDB
MONGO_URI=mongodb://mongo:27017/library_management_dev
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
MONGO_INITDB_DATABASE=library_management_dev

# Server
PORT=8080
NODE_ENV=development
SESSION_SECRET=dev_session_secret_change_in_production

# Test Users for Development
TEST_LIBRARIAN_FULLNAME=Main Librarian
TEST_LIBRARIAN_EMAIL=mainlibrarian@library.com
TEST_LIBRARIAN_PASSWORD=librarian123

TEST_MEMBER_FULLNAME=Test Member
TEST_MEMBER_EMAIL=testmember@library.com
TEST_MEMBER_PASSWORD=member123

# Frontend
REACT_APP_API_URL=http://localhost:8080 


