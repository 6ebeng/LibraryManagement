{
  "name": "library_management_system_frontend",
  "description": "Frontend of a simple Library Management System for RAD MERN project, built using React and MUI (@minimal/material-kit-react)",
  "keywords": [
    "rad",
    "mern",
    "library-app",
    "react",
    "mui"
  ],
  "authors": [
    "Sandul Renuja",
    "Abdullah Jasmine",
    "Ravindu Wegiriya",
    "Kaveesha Muthukuda",
    "Induwara Pathirana"
  ],
  "licence": "MIT",
  "version": "1.6.0",
  "private": false,
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test --watchAll=false --json --outputFile=./test-results/results.json",
    "test:coverage:report": "react-scripts test --watchAll=false --coverage --coverageReporters=json --coverageReporters=lcov --coverageReporters=text --coverageReporters=clover --coverageReporters=html --json --outputFile=./test-results/results.json --reporters=jest-html-reporters",
    "eject": "react-scripts eject",
    "lint": "eslint --ext .js,.jsx ./src",
    "lint:fix": "eslint --fix --ext .js,.jsx ./src",
    "clear-all": "rimraf build node_modules",
    "re-start": "rimraf build node_modules && npm install && npm start",
    "re-build": "rimraf build node_modules && npm install && npm build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "parser": "@babel/eslint-parser",
    "parserOptions": {
      "requireConfigFile": false,
      "babelOptions": {
        "presets": [
          [
            "@babel/preset-react",
            {
              "runtime": "automatic"
            }
          ]
        ]
      }
    }
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-react",
        {
          "runtime": "automatic"
        }
      ]
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.10.4",
    "@emotion/styled": "^11.10.4",
    "@iconify/react": "^4.0.0",
    "@mui/lab": "^5.0.0-alpha.103",
    "@mui/material": "^5.10.9",
    "apexcharts": "^4.0.0",
    "axios": "^1.1.3",
    "date-fns": "^2.29.3",
    "lodash": "^4.17.21",
    "numeral": "^2.0.6",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-apexcharts": "^1.4.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^1.3.0",
    "react-hook-form": "^7.37.0",
    "react-hot-toast": "^2.4.0",
    "react-icons": "^4.6.0",
    "react-router-dom": "^6.4.2",
    "react-scripts": "^5.0.1",
    "simplebar-react": "^2.4.3",
    "web-vitals": "^3.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.19.3",
    "@babel/eslint-parser": "^7.24.1",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "eslint": "^8.25.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.5.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsx-a11y": "^6.6.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.31.10",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest-html-reporters": "^3.1.7",
    "prettier": "^2.7.1",
    "rimraf": "^5.0.1"
  },
  "overrides": {
    "@svgr/webpack": "^6.5.0"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/**/*.test.{js,jsx}",
      "!src/index.js",
      "!src/serviceWorker.js",
      "!src/reportWebVitals.js"
    ],
    "coverageReporters": [
      "json",
      "lcov",
      "text",
      "clover",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 50,
        "branches": 50,
        "functions": 50,
        "lines": 50
      }
    }
  },
  "jest-html-reporters": {
    "filename": "report.html",
    "outputPath": "./test-results/jest-html-report/",
    "pageTitle": "Library Management Client Test Report",
    "expand": true,
    "hideIcon": false,
    "testCommand": "npm test",
    "openReport": true,
    "inlineSource": true,
    "includeConsoleLog": true,
    "darkTheme": false,
    "urlForTestFiles": "",
    "customInfos": [
      {
        "title": "Project",
        "value": "Library Management System"
      },
      {
        "title": "Component",
        "value": "Client"
      },
      {
        "title": "Date",
        "value": "2025-06-12 17:04:58"
      },
      {
        "title": "Generated by",
        "value": "6ebeng"
      }
    ]
  }
}
