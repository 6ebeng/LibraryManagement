# ---- Base Stage ----
FROM node:18-alpine AS base
WORKDIR /app
COPY package*.json ./

# ---- Development Stage ----
FROM base AS development
ENV NODE_ENV=development
# Install all dependencies, including devDependencies
RUN npm install
COPY . .
# Expose the port CRA runs on by default
EXPOSE 3000
# Default command for development (will be overridden by docker-compose)
CMD [ "npm", "start" ]

# ---- Build Stage ----
FROM base AS build
ENV NODE_ENV=production
# Install all dependencies (needed for build process)
RUN npm install
COPY . .
# Build the React application
RUN npm run build

# ---- Production Stage ----
# Use a lightweight static server or a multi-stage build with Nginx
# Option 1: Using 'serve' package
FROM node:18-alpine AS production
ENV NODE_ENV=production
WORKDIR /app

# Install 'serve' globally
RUN npm install -g serve

# Copy build artifacts from the build stage
COPY --from=build /app/build ./build

# Expose the port serve will run on (or your Nginx port)
EXPOSE 3000

# Serve the build folder
CMD [ "serve", "-s", "build", "-l", "3000" ]

# Option 2: If you prefer Nginx (example)
# FROM nginx:stable-alpine AS production
# COPY --from=build /app/build /usr/share/nginx/html
# # You might need an nginx.conf file copied as well
# # COPY nginx.conf /etc/nginx/conf.d/default.conf
# EXPOSE 80
# CMD ["nginx", "-g", "daemon off;"]