# ---- Base Stage ----
FROM node:18-alpine AS base
WORKDIR /app
COPY package*.json ./

# ---- Dependencies Stage ----
FROM base AS dependencies
RUN npm install --silent

# ---- Development Stage (for api-tester, general dev) ----
FROM dependencies AS development
ENV NODE_ENV=development
COPY . .
# entrypoint.sh also runs seed and then npm run dev
# CMD ["sh", "/app/entrypoint.sh"]
# For api-tester, the command is overridden by docker-compose.test.yml

# ---- E2E Test Server Stage (for backend-e2e) ----
FROM dependencies AS e2e-test-server
ENV NODE_ENV=test
ENV E2E_TESTING=true
COPY . .
# entrypoint-e2e.sh is specified in docker-compose.test.yml for this service
# It handles seeding and starting the dev server.

# ---- Production Stage ----
FROM base AS production
ENV NODE_ENV=production
RUN npm ci --only=production --silent
COPY . .
EXPOSE 8080
CMD ["npm", "start"]