# ---- Base Stage ----
FROM node:18-alpine AS base
WORKDIR /app

# Copy package.json and package-lock.json (or yarn.lock)
COPY package*.json ./

# Set production environment for this stage to ensure only prod dependencies are considered by default for 'npm ci' if used later
ENV NODE_ENV=production

# ---- Production Stage ----
FROM base AS production
# Install only production dependencies
RUN npm ci --only=production
# Copy the rest of the application code
COPY . .
# Expose the application port (as seen in docker-compose files, backend runs on 8080 internally)
EXPOSE 8080
# Default command to start the server in production
CMD [ "node", "index.js" ]

# ---- Development Stage ----
FROM base AS development
# Install all dependencies, including devDependencies
RUN npm install
# Copy the rest of the application code
COPY . .
# Expose the application port
EXPOSE 8080
# Default command for development (e.g., using nodemon if it's a dev dependency)
# This will typically be overridden by docker-compose.yml or docker-compose.dev.yml
CMD [ "npm", "run", "dev" ]