# Base image for production
FROM node:18-alpine AS base
WORKDIR /app
COPY package*.json ./
RUN npm install --production

# Stage for development
FROM base AS development 
ENV NODE_ENV=development
RUN npm install
COPY . .
CMD ["npm", "run", "dev"]

# Stage for production (could be different or built upon base)
FROM base AS production
ENV NODE_ENV=production
COPY . .
# Ensure you only have production dependencies if you build from base and copied node_modules
# Or copy from a builder stage that has all modules then prune devDependencies
CMD ["npm", "start"]