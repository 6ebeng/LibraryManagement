{
	"name": "library_management_system_backend",
	"version": "1.1.0",
	"description": "Backend of a simple Library Management System for RAD MERN project, built using Express and MongoDB",
	"keywords": [
		"rad",
		"mern",
		"library-app",
		"express",
		"mongodb"
	],
	"authors": [
		"Sandul Renuja",
		"Abdullah Jasmine",
		"Ravindu Wegiriya",
		"Kaveesha Muthukuda",
		"Induwara Pathirana"
	],
	"main": "index.js",
	"scripts": {
		"test": "npm run test:api",
		"dev": "nodemon index.js",
		"start": "node index.js",
		"seed": "node scripts/seedDatabase.js",
		"setup:test": "node scripts/seedDatabase.js",
		"test:api": "npx jest --coverage --runInBand --detectOpenHandles --forceExit",
		"test:api:watch": "npx jest --watchAll"
	},
	"license": "ISC",
	"dependencies": {
		"cookie-parser": "^1.4.6",
		"cors": "^2.8.5",
		"dotenv": "^16.0.3",
		"express": "^4.18.2",
		"express-session": "^1.17.3",
		"mongoose": "^6.6.7",
		"morgan": "^1.10.0",
		"passport": "^0.6.0",
		"passport-local": "^1.0.0"
	},
	"devDependencies": {
		"axios": "^1.9.0",
		"jest": "^29.7.0",
		"jest-html-reporters": "^3.1.7",
		"mongodb": "^4.11.0",
		"nodemon": "^2.0.20",
		"supertest": "^7.1.1"
	},
	"jest": {
		"testEnvironment": "node",
		"setupFilesAfterEnv": [
			"<rootDir>/jest.setup.js"
		],
		"collectCoverageFrom": [
			"**/*.js",
			"!**/node_modules/**",
			"!**/__tests__/**",
			"!index.js",
			"!scripts/**",
			"!passport-config.js"
		],
		"coverageReporters": [
			"json",
			"lcov",
			"text",
			"clover",
			"html"
		],
		"coverageThreshold": {
			"global": {
				"statements": 50,
				"branches": 50,
				"functions": 50,
				"lines": 50
			}
		},
		"reporters": [
			"default",
			[
				"jest-html-reporters",
				{
					"publicPath": "./test-report",
					"filename": "report.html",
					"pageTitle": "API Test Report",
					"expand": true
				}
			]
		]
	}
}
